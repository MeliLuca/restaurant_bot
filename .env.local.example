# Copy to .env.local and fill in from your Supabase project settings
# (Dashboard -> Project Settings -> API), or from `supabase start` output
# if running the local CLI stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Assistente AI — PROTOTYPE, never in production. Both flags off (absent) =
# no menu entry, no settings card, every /api/ai route answers 404.
# AI_PROTOTYPE=1
# NEXT_PUBLIC_AI_PROTOTYPE=1
# Ollama on the venue's Mac mini (M4, 32 GB); see docs/ai-module.md
# OLLAMA_HOST=http://127.0.0.1:11434
# AI_MODEL=gemma4:e4b
# A CPU-only dev laptop needs a much longer timeout (e.g. 180000)
# AI_TIMEOUT_MS=30000
