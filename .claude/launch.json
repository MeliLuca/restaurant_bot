{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-H", "0.0.0.0", "-p", "3000"],
      "port": 3000
    }
  ]
}
